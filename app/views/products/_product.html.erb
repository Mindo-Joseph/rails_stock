<%= turbo_frame_tag dom_id(product) do %>
  <div class="w-full bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-200"
       data-controller="stock"
       data-id="<%= product.id %>"
       data-test-id="product-<%= product.id %>"
       data-stock-product-id-value="<%= product.id %>"
       data-stock-threshold-value="<%= product.low_stock_threshold %>">

    <%# Header section with name and stock status %>
    <div class="flex justify-between items-start mb-4">
      <div>
        <h2 class="text-xl font-semibold text-gray-800 hover:text-purple-600 transition-colors">
          <%= link_to product.name, product_path(product) %>
        </h2>
        <p class="text-sm text-gray-500 mt-1 font-mono"><%= product.sku %></p>
      </div>

      <div class="flex items-center">
        <% if product.low_stock? %>
          <span class="px-3 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Low Stock</span>
        <% else %>
          <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">In Stock</span>
        <% end %>
      </div>
    </div>

    <%# Description %>
    <p class="text-gray-600 mb-4 line-clamp-2"><%= product.description %></p>

    <%# Price and Current Stock %>
    <div class="flex items-center justify-between mb-4">
      <span class="text-2xl font-bold text-gray-900"><%= format_price(product.price) %></span>
      <div class="flex items-center space-x-2">
        <span class="text-sm text-gray-600">Stock:</span>
        <span class="font-medium text-gray-800" data-stock-target="quantity"><%= product.quantity %></span>
      </div>
    </div>

    <%# Stock Update Form and Action Buttons %>
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <%= form_with(model: product, class: "flex items-center space-x-2", data: { turbo_stream: true }) do |f| %>
          <%= f.number_field :quantity,
              min: 0,
              class: "w-24 rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500",
              data: {
                action: "change->stock#updateQuantity",
                stock_target: "input"
              } %>
          <%= f.submit "Update", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <%= link_to edit_product_path(product),
          class: "text-sm text-gray-600 hover:text-purple-600 transition-colors p-2",
          data: { turbo_frame: dom_id(product) } do %>
        <i class="fas fa-edit"></i>
        <% end %>
        <%= button_to product_path(product),
            method: :delete,
            class: "text-sm text-red-600 hover:text-red-800 transition-colors p-2",
            form: { data: { turbo_confirm: "Are you sure you want to delete this product?" } } do %>
          <i class="fas fa-trash"></i>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
