<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @product.name %></h1>
        <p class="text-sm text-gray-500 mt-1">SKU: <%= @product.sku %></p>
      </div>
      <%= stock_status_badge(@product) %>
    </div>

    <div class="mt-6">
      <h3 class="text-lg font-medium text-gray-900">Description</h3>
      <p class="mt-2 text-gray-600"><%= @product.description %></p>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <h3 class="text-sm font-medium text-gray-500">Price</h3>
        <p class="mt-1 text-lg font-semibold text-gray-900"><%= format_price(@product.price) %></p>
      </div>

      <div>
        <h3 class="text-sm font-medium text-gray-500">Current Stock</h3>
        <p class="mt-1 text-lg font-semibold text-gray-900"><%= @product.quantity %> units</p>
      </div>

      <div>
        <h3 class="text-sm font-medium text-gray-500">Low Stock Alert</h3>
        <p class="mt-1 text-lg font-semibold text-gray-900"><%= @product.low_stock_threshold %> units</p>
      </div>
    </div>

    <div class="mt-8 flex justify-end space-x-3">
      <%= link_to "Back to Products", products_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50" %>
      <%= link_to "Edit Product", edit_product_path(@product), class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md shadow-sm hover:bg-blue-700" %>
    </div>
  </div>
</div>
