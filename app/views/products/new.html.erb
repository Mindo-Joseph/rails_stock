<%= turbo_frame_tag "new_product" do %>
  <div class="max-w-2xl mx-auto bg-white p-6 rounded-lg shadow mb-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-semibold text-gray-900">New Product</h2>
      <%= link_to products_path, class: "text-gray-500 hover:text-gray-700" do %>
        <i class="fas fa-times"></i>
      <% end %>
    </div>

    <%= render "form", product: @product %>
  </div>
<% end %>
