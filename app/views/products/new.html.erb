<%= turbo_frame_tag "new_product" do %>
  <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-200">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h2 class="text-xl font-semibold text-gray-800">New Product</h2>
      </div>
      <%= link_to products_path, class: "text-gray-500 hover:text-gray-700" do %>
        <i class="fas fa-times"></i>
      <% end %>
    </div>

    <%= render "form", product: @product %>
  </div>
<% end %>
