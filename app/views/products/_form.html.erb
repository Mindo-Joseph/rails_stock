<%= form_with(model: product, class: "space-y-4") do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 p-4 rounded-lg mb-4">
      <div class="text-sm text-red-700">
        <h3 class="font-medium"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h3>
        <ul class="list-disc pl-5 mt-2">
          <% product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
  </div>

  <div>
    <%= f.label :sku, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :sku, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 2, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :price, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :price, step: "0.01", min: 0, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
    </div>

    <div>
      <%= f.label :quantity, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :quantity, min: 0, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
    </div>

    <div>
      <%= f.label :low_stock_threshold, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :low_stock_threshold, min: 1, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3 pt-4">
    <%= f.submit class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
  </div>
<% end %>
