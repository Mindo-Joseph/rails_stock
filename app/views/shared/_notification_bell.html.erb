<div id="notification_bell" class="fixed top-4 right-4 notification-bell" data-controller="notification">
  <div class="relative">
    <%= link_to notifications_path, class: "text-gray-600 hover:text-gray-900" do %>
      <i class="fas fa-bell text-xl"></i>
      <% if Notification.unread.exists? %>
        <%= render "shared/notification_count", count: Notification.unread.count %>
      <% end %>
    <% end %>
  </div>
</div>
