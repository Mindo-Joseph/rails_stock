<div id="<%= dom_id(notification) %>" class="bg-white rounded-lg shadow p-4 <%= notification.unread? ? 'border-l-4 border-blue-500' : '' %>">
  <div class="flex justify-between items-start">
    <div>
      <h3 class="font-semibold"><%= notification.title %></h3>
      <p class="text-sm text-gray-600 mt-1"><%= notification.message %></p>
      <span class="text-xs text-gray-500"><%= time_ago_in_words(notification.created_at) %> ago</span>
    </div>
    <% if notification.unread? %>
      <%= button_to mark_as_read_notification_path(notification),
          class: "text-sm text-gray-500 hover:text-gray-700",
          data: { turbo_method: :patch } do %>
        Mark as read
      <% end %>
    <% end %>
  </div>
</div>
