<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold mb-6">Notifications</h1>

  <div class="space-y-4">
    <% @notifications.each do |notification| %>
      <%= turbo_frame_tag dom_id(notification) do %>
        <div class="bg-white rounded-lg shadow p-4 <%= notification.unread? ? 'border-l-4 border-blue-500' : '' %>">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="font-semibold"><%= notification.title %></h3>
              <p class="text-sm text-gray-600 mt-1"><%= notification.message %></p>
              <p class="text-xs text-gray-500 mt-2">
                <%= time_ago_in_words(notification.created_at) %> ago
              </p>
            </div>

            <% if notification.unread? %>
              <%= button_to mark_as_read_notification_path(notification),
                          class: "text-sm text-blue-600 hover:text-blue-800",
                          data: { turbo_frame: dom_id(notification) } do %>
                Mark as read
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @notifications.empty? %>
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <p class="text-gray-500">No notifications yet</p>
      </div>
    <% end %>
  </div>
</div>
